# API server environment. Copy to backend/.env for local development.
# Never commit a real .env file (it is gitignored). Production values are set
# in the hosting provider's environment settings, not in a file.

# development | test | production
NODE_ENV=development

# Port the Express server listens on (the hosting platform often sets this).
PORT=5000

# MongoDB Atlas connection string. Create a free cluster, create a database user
# with access to the nfpc database only, then paste the connection string here.
# The path segment (/nfpc) is the database name. Uploaded images are stored in
# this same database (GridFS), so no other storage credential is needed.
# See docs/DATABASE.md.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nfpc

# Exact origin of the website, used for CORS. Production must use https://.
# Example: https://www.your-domain.example (no trailing slash, no path).
FRONTEND_URL=http://localhost:5173

# Signs admin session tokens (HS256). At least 32 random characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# How long an admin session lasts (jsonwebtoken format, e.g. 8h, 1d).
JWT_EXPIRES_IN=8h

# Number of reverse proxies in front of the API: 0 when the API is reached
# directly, 1 behind a single hosting proxy. Needed for correct per-client
# login rate limiting on hosted platforms. See docs/DEPLOYMENT.md.
TRUST_PROXY=0

# Used ONLY by `npm run create-admin` to create or reset the single admin account.
# Pass them on the command line or set them for that one command; do not keep them
# in a file. The password must be at least 12 characters.
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
