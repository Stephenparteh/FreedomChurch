# Copy to .env for local development. Never commit the real file (see .gitignore).

# development | test | production
NODE_ENV=development

# Port the Express server listens on.
PORT=5000

# MongoDB Atlas connection string. Create a free cluster at
# https://www.mongodb.com/cloud/atlas, then paste its connection string here.
# The path segment (/nfpc) is the database name. Never commit a real value.
# See docs/DATABASE.md for setup steps.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nfpc

# The frontend origin allowed to call this API (CORS). No wildcard in production.
FRONTEND_URL=http://localhost:5173

# Signs admin session tokens (HS256). Must be at least 32 characters, random.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Directory for uploaded images (served at /uploads). Relative to the backend folder.
# Use a persistent volume in production; see docs/DATABASE.md.
UPLOAD_DIR=uploads

# Used ONLY by `npm run create-admin` to create or reset the admin account.
# Remove these lines after running it. Never commit real values.
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=   (at least 12 characters)
