# NFPC V2 — environment variables
#
# This is a monorepo-level reference for every environment variable the
# system will eventually need, across milestones. Copy the relevant lines
# into frontend/.env(.local) and (once it exists) backend/.env — never
# commit a real .env file. See docs/BACKEND_PLAN.md for details.

# ---------------------------------------------------------------------------
# Frontend (Vite) — must be prefixed with VITE_ to be exposed to the client
# ---------------------------------------------------------------------------

# Base URL of the backend API. Points at a local backend during development
# and the deployed API in production. Unused until Milestone 3.
VITE_API_URL=http://localhost:4000/api

# ---------------------------------------------------------------------------
# Backend (Node/Express) — Milestone 3+, not implemented yet
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string. Never commit a real value.
MONGODB_URI=

# Port the Express server listens on.
PORT=4000

# Secret used to sign admin session/JWT tokens. Generate a long random value.
AUTH_SECRET=

# Comma-separated list of origins allowed to call the API (CORS).
CORS_ORIGIN=http://localhost:5173

# Environment name: development | production | test
NODE_ENV=development
