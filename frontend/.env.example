# Copy to frontend/.env.local for local development, or set in the hosting
# provider for production builds. Vite embeds VITE_* values in the public JavaScript,
# so put only public values here. Never put secrets in a VITE_ variable.

# Base URL of the API, including /api. Local default shown.
# Production example: https://api.your-domain.example/api
VITE_API_URL=http://localhost:5000/api
